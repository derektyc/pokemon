{
  "name": "Pokémon Pack Simulator",
  "short_name": "Pokémon Packs",
  "description": "A multi-series Pokémon pack-opening simulator with binders, progression, quests and Google Drive cloud saves.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0e1016",
  "theme_color": "#0e1016",
  "orientation": "any",
  "prefer_related_applications": false,
  "categories": [
    "games",
    "entertainment"
  ],
  "icons": [
    {
      "src": "./assets/pokeball-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/pokeball-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/pokeball-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}